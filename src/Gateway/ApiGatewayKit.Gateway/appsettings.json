{
  "AdminUI": {
    "DevServerUrls": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ],
    "ProductionUrl": "https://admin.yourdomain.com",
    "RedirectUrl": "http://localhost:3000/admin"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "RateLimitOptions": {
    "UseRedis": false
  },
  "ModuleParsing": {
    "PathPatterns": [
      { "Prefix": "moim/api/v1/internet", "ModuleSegmentIndex": 4 },
      { "Prefix": "api", "ModuleSegmentIndex": 1 }
    ],
    "ModuleAliases": {
      "billlimit": "Bill",
      "genericmessages": "GenericMessages",
      "linesuspension": "LineSuspension",
      "autopayment": "AutoPayment",
      "endtoend": "EndToEnd",
      "pratiknet": "PratikNet",
      "banaozel": "BanaOzel",
      "unicaoffer": "Product"
    }
  },
  "ModuleDefinitions": {
    "Auth": { "Name": "Kimlik Doğrulama", "Description": "Giriş, oturum ve token işlemleri" },
    "Usage": { "Name": "Kullanım", "Description": "Kullanım geçmişi ve detayları" },
    "Bill": { "Name": "Fatura", "Description": "Fatura sorgulama, ödeme ve e-fatura işlemleri" },
    "Product": { "Name": "Ürün", "Description": "Ürün listeleme, detay ve UNICA işlemleri" },
    "Campaigns": { "Name": "Kampanyalar", "Description": "Kampanya listeleme ve katılım işlemleri" },
    "Packages": { "Name": "Paketler", "Description": "Paket listeleme, değişiklik ve TİVİBU işlemleri" },
    "PratikNet": { "Name": "Pratik Net", "Description": "Bağlantı sorunları, hız testi ve destek talepleri" },
    "Guest": { "Name": "Misafir", "Description": "Misafir girişi ve randevu işlemleri" },
    "Lead": { "Name": "Müşteri Adayı", "Description": "Müşteri adayı işlemleri" },
    "Subscriber": { "Name": "Abone", "Description": "Abone bilgileri ve topluluk işlemleri" },
    "Settings": { "Name": "Ayarlar", "Description": "Modem ve güvenlik ayarları" },
    "EndToEnd": { "Name": "Uçtan Uca", "Description": "Sipariş ve randevu işlemleri" },
    "Profile": { "Name": "Profil", "Description": "Kullanıcı profili ve geçmişi" },
    "Address": { "Name": "Adres", "Description": "İl, ilçe, mahalle ve sokak sorguları" },
    "Dashboard": { "Name": "Gösterge Paneli", "Description": "Ana sayfa ve özet bilgiler" },
    "Thk": { "Name": "THK", "Description": "Taksitli hız kampanyaları" },
    "Document": { "Name": "Doküman", "Description": "Belge gönderme ve alma işlemleri" },
    "Otp": { "Name": "OTP", "Description": "Tek kullanımlık şifre işlemleri" },
    "LineSuspension": { "Name": "Hat Askıya Alma", "Description": "Hat askıya alma ve iptal işlemleri" },
    "AutoPayment": { "Name": "Otomatik Ödeme", "Description": "Otomatik ödeme talimatı işlemleri" },
    "Flow": { "Name": "Akış", "Description": "İş akışı işlemleri" },
    "Features": { "Name": "Özellikler", "Description": "OVIT ve özel teklifler" },
    "BanaOzel": { "Name": "Bana Özel", "Description": "Promosyon kodları ve özel kampanyalar" },
    "Digitt": { "Name": "Dijital Teklifler", "Description": "Dijital teklifler" },
    "Image": { "Name": "Görsel", "Description": "Captcha ve görsel işlemleri" },
    "GenericMessages": { "Name": "Genel Mesajlar", "Description": "Sistem mesajları" },
    "Adid": { "Name": "ADID", "Description": "Reklam kimliği işlemleri" }
  },
  "GatewayAdmin": {
    "Enabled": true,
    "IpWhitelist": [
      "127.0.0.1",
      "::1",
      "10.0.0.0/8",
      "192.168.0.0/16",
      "172.16.0.0/12"
    ],
    "ApiKeys": [
      {
        "Name": "DevOps-Team",
        "KeyHash": "sha256:3b612c75a7b5048a435fb6ec81e52ff92d6d795a8b5a9c17070f6a63c97a53b2",
        "Permissions": [ "read", "write", "emergency" ],
        "IsActive": true
      },
      {
        "Name": "Monitoring-ReadOnly",
        "KeyHash": "sha256:9d9af7f567897ebe0a251a9488fb2ebbf4de8bdba284195e9c8fb700aef8282a",
        "Permissions": [ "read" ],
        "IsActive": true
      }
    ],
    "RateLimit": {
      "Enabled": true,
      "RequestsPerMinute": 30,
      "BlockDurationMinutes": 5
    },
    "Audit": {
      "Enabled": true,
      "FilePath": "logs/admin-audit/audit-{Date}.log",
      "LogRequestBody": true,
      "LogResponseBody": false
    },
    "Production": {
      "DisableWriteEndpoints": false,
      "AllowedEndpoints": []
    }
  },
  "DownstreamWatcher": {
    "Enabled": true,
    "CheckIntervalSeconds": 60
  },
  "Gateway": {
    "DefaultTarget": "Legacy",
    "LegacyBaseUrl": "http://localhost:39414",
    "NewBaseUrl": "https://localhost:52201",
    "WcfBaseUrl": "http://localhost:52300",
    "LegacyPathPrefix": "/moim/api/v1/internet",
    "NewPathPrefix": "/api",
    "EnableShadowMode": false,
    "RequestTimeoutSeconds": 120,
    "RetryCount": 2,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30,
    "BulkheadMaxParallelization": 100,
    "BulkheadMaxQueuingActions": 50,
    "BypassHealthChecks": true,
    "BypassPaths": [
      "/swagger",
      "/health",
      "/favicon.ico",
      "/api/gateway",
      "/admin"
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 500
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 10000
      }
    ]
  },
  "CacheProvider": {
    "Provider": "Redis",
    "ConnectionString": "localhost:6379",
    "InstanceName": "apigatewaykit-gateway",
    "AppId": "gateway-001",
    "EnablePreload": false,
    "ClearOnStartup": false
  },
  "Logging": {
    "ApplicationName": "ApiGatewayKit.Gateway",
    "ApplicationVersion": "1.0.0",
    "Environment": "Development",
    "BufferSize": 10000,
    "BatchSize": 100,
    "FlushIntervalMs": 5000,
    "RequestBodyMaxLength": 32768,
    "ResponseBodyMaxLength": 32768,
    "File": {
      "Enabled": true,
      "BasePath": "C:\\Logs",
      "UseApplicationSubfolder": true,
      "RetentionDays": 30,
      "MaxFileSizeMB": 100,
      "RollingInterval": "Day",
      "SeparateFiles": {
        "AllLogs": true,
        "ErrorLogs": true,
        "RequestLogs": true,
        "PerformanceLogs": true,
        "BusinessLogs": true,
        "SecurityLogs": true
      }
    },
    "Database": {
      "Enabled": false
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:53000"
      },
      "Https": {
        "Url": "https://localhost:53001"
      }
    }
  }
}

