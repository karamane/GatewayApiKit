<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ApiGatewayKit.Gateway</RootNamespace>
    <AssemblyName>ApiGatewayKit.Gateway</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="Ocelot.Provider.Polly" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Extensions.Http" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- Ocelot Gateway -->
    <PackageReference Include="Ocelot" />
    <PackageReference Include="Ocelot.Cache.CacheManager" />
    <PackageReference Include="MMLib.SwaggerForOcelot" />
    <!-- Feature Management -->
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
    <!-- Performance: Rate Limiting & Response Compression -->
    <PackageReference Include="AspNetCoreRateLimit" />
    <PackageReference Include="AspNetCoreRateLimit.Redis" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ApiGatewayKit.Core.Shared\ApiGatewayKit.Core.Shared.csproj" />
    <ProjectReference Include="..\..\Core\ApiGatewayKit.Core.Application\ApiGatewayKit.Core.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\ApiGatewayKit.Infrastructure.Caching\ApiGatewayKit.Infrastructure.Caching.csproj" />
    <ProjectReference Include="..\..\Infrastructure\ApiGatewayKit.Infrastructure.Logging\ApiGatewayKit.Infrastructure.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="gateway-targets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
